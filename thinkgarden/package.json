{
  "name": "thinkgarden",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "dev:desktop": "node scripts/dev.mjs",
    "build": "next build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:desktop": "npm run build && npm run build:electron",
    "start": "next start",
    "lint": "next lint",
    "pack": "npm run build:desktop && electron-builder --dir",
    "dist": "npm run build:desktop && electron-builder",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run --coverage"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "next": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^35.2.1",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
