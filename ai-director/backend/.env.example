# ============================================================
# AI Director — LLM 配置
# ============================================================
# 复制此文件为 .env，然后填入你的 API Key
#
# 推荐顺序（按性价比）：
#   1. DeepSeek   — 最便宜，效果好
#   2. 硅基流动   — 免费额度多
#   3. 通义千问   — 中文优化
#   4. 智谱 GLM   — 中文优化
#   5. OpenAI    — 效果最好，但较贵
# ============================================================

# ---- 必须填写的 API Key ----
# DeepSeek（推荐，便宜又好用）
AI_DIRECTOR_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
AI_DIRECTOR_LLM_BASE_URL=https://api.deepseek.com/v1
AI_DIRECTOR_LLM_MODEL=deepseek-chat
AI_DIRECTOR_LLM_PROVIDER=deepseek

# ---- 或者用硅基流动（免费额度）----
# AI_DIRECTOR_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AI_DIRECTOR_LLM_BASE_URL=https://api.siliconflow.cn/v1
# AI_DIRECTOR_LLM_MODEL=deepseek-ai/DeepSeek-V3
# AI_DIRECTOR_LLM_PROVIDER=siliconflow

# ---- 或者用通义千问 ----
# AI_DIRECTOR_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AI_DIRECTOR_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_DIRECTOR_LLM_MODEL=qwen-plus
# AI_DIRECTOR_LLM_PROVIDER=qwen

# ---- 或者用智谱 GLM ----
# AI_DIRECTOR_LLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# AI_DIRECTOR_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_DIRECTOR_LLM_MODEL=glm-4-flash
# AI_DIRECTOR_LLM_PROVIDER=zhipu

# ---- 或者用 OpenAI ----
# AI_DIRECTOR_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AI_DIRECTOR_LLM_BASE_URL=https://api.openai.com/v1
# AI_DIRECTOR_LLM_MODEL=gpt-4o-mini
# AI_DIRECTOR_LLM_PROVIDER=openai

# ---- 其他可选配置 ----
AI_DIRECTOR_WHISPER_MODEL_SIZE=medium
AI_DIRECTOR_WHISPER_DEVICE=cuda
AI_DIRECTOR_WHISPER_COMPUTE_TYPE=float16
AI_DIRECTOR_OUTPUT_DIR=./output
AI_DIRECTOR_SUBTITLE_FONT=Microsoft YaHei
AI_DIRECTOR_SUBTITLE_FONTSIZE=24
AI_DIRECTOR_CLIP_MODEL_NAME=OFA-Sys/chinese-clip-vit-base-patch16
AI_DIRECTOR_CHROMA_PERSIST_DIR=./data/chroma
